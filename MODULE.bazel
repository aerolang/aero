module(name = "aero")

bazel_dep(name = "cxx.rs", version = "1.0.194")
bazel_dep(name = "flatbuffers", version = "25.12.19")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_zig", version = "0.14.0")

# LLVM doesn't support bzlmod yet, so it's fetched as an HTTP archive.
LLVM_COMMIT = "35990504507d79e0b9deb809c8ee5e1b34ceef20"

LLVM_INTEGRITY = "sha256-RbjYZg3DiQ1powOTvjyKzFXmLraf22fH7Bere8pvQ+Y="

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "llvm-raw",
    build_file_content = "# empty",
    integrity = LLVM_INTEGRITY,
    patch_args = ["-p1"],
    patches = ["//bazel/patches:llvm_codegen_alwayslink.patch"],
    strip_prefix = "llvm-project-" + LLVM_COMMIT,
    urls = ["https://github.com/llvm/llvm-project/archive/{commit}.tar.gz".format(commit = LLVM_COMMIT)],
)

# Now also fetching LLVM's dependencies.
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.0.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

http_archive(
    name = "llvm_zlib",
    build_file = "@llvm-raw//utils/bazel/third_party_build:zlib-ng.BUILD",
    sha256 = "e36bb346c00472a1f9ff2a0a4643e590a254be6379da7cddd9daeb9a7f296731",
    strip_prefix = "zlib-ng-2.0.7",
    urls = [
        "https://github.com/zlib-ng/zlib-ng/archive/refs/tags/2.0.7.zip",
    ],
)

http_archive(
    name = "llvm_zstd",
    build_file = "@llvm-raw//utils/bazel/third_party_build:zstd.BUILD",
    sha256 = "eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3",
    strip_prefix = "zstd-1.5.7",
    urls = [
        "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz",
    ],
)

# Build @llvm-project using LLVM's Bazel overlays.
#
# Bazel currently fails if not loading the NVPTX target since some tests are
# dependent on it. See https://github.com/llvm/llvm-project/issues/63135.
llvm_configure = use_repo_rule("@llvm-raw//utils/bazel:configure.bzl", "llvm_configure")

llvm_configure(
    name = "llvm-project",
    targets = [
        "X86",
        "AArch64",
        "NVPTX",
    ],
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

zig = use_extension("@rules_zig//zig:extensions.bzl", "zig")
zig.toolchain(
    default = True,
    zig_version = "0.16.0",
)
