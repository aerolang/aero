Source = { SOI ~ Defs ~ EOI }

Defs = _{ Ws? ~ Def ~ (Ws ~ Def)* ~ Ws? }
Def = _{
  "(" ~ Ws? ~ "def" ~ Ws ~ Vis ~ Ws ~ DefInner ~ Ws? ~ ")"
}
DefInner = _{ MainDef | FuncDef }

Vis = _{ Pub | Priv }
Pub = @{ "pub" }
Priv = @{ "priv" }

MainDef = {
  "main" ~ Ws ~ "do:" ~ Ws
  ~ (Assign ~ Ws)* ~ Expr ~ Ws?
}

FuncDef = {
  "func" ~ Ws ~ DefName ~ Ws ~ ParamList ~ Ws ~ "->" ~ Ws ~ Type ~ Ws ~ "do:" ~ Ws
  ~ (Assign ~ Ws)* ~ Expr ~ Ws?
}

ParamList = { "(" ~ Ws? ~ (Param ~ (Ws ~ Param)*)? ~ Ws? ~ ")" }
Param = { VarName ~ Ws ~ Type }

Assign = { VarName ~ Ws ~ Type ~ Ws ~ "=" ~ Ws ~ Expr }

Expr = _{ SimpleExpr | Call }
SimpleExpr = _{ Void | Str | Sym | VarName | DefName }

Void = { "(" ~ Ws? ~ ")" }

Str = { "\"" ~ StrContent ~ "\"" }
StrContent = @{ (!"\"" ~ ANY)* }

Call = { "(" ~ Ws? ~ Callee ~ (Ws ~ SimpleExpr)* ~ Ws? ~ ")" }
Callee = _{ Builtin | DefName | VarName }
Builtin = { Name }

Type = _{ IntType | StrType | VoidType }

IntType = @{ "Int" }
StrType = @{ "Str" }
VoidType = @{ "Void" }

Label = { Name ~ ":" }
Sym = { "." ~ Name }
GlobalPath = { ("/" ~ Name)+ }
LocalPath = { Name ~ ("/" ~ Name)+ }
DefName = { "$" ~ Name }
VarName = { "%" ~ Name }

Name = { (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "-")* }

Ws = _{ Space | Newline }
Space = _{ (" " | "\t")+ }
Newline = _{
  Space? ~ ((";" ~ (!("\n" | "\r") ~ ANY)*)? ~ ("\n" | "\r\n" | "\r") ~ Space?)+
}
