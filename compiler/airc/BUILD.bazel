load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "airc_lib",
    srcs = ["src/lib.rs"],
    aliases = aliases(),
    crate_name = "airc",
    deps = all_crate_deps(normal = True) + [
        "//compiler/airc-codegen",
        "//compiler/airc-syntax",
    ],
)

rust_binary(
    name = "airc",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    data = [
        ":support/libbuiltins.a",
        ":support/libruntime.a",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        ":airc_lib",
        "//compiler/airc-codegen",
        "//compiler/airc-syntax",
    ],
)

rust_test(
    name = "integration_test",
    srcs = ["tests/integration_test.rs"],
    aliases = aliases(),
    data = [
        ":support/libbuiltins.a",
        ":support/libruntime.a",
    ],
    env = {
        "SUPPORT_PATH": "$(rootpath :support/libruntime.a)",
    },
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":airc_lib",
    ],
)

copy_file(
    name = "runtime_lib_copy",
    src = "//support/runtime",
    out = "support/libruntime.a",
)

copy_file(
    name = "builtins_lib_copy",
    src = "//support/builtins",
    out = "support/libbuiltins.a",
)
